:root {
    --text: rgb(239, 247, 255);
    --muted: rgb(153, 177, 205);
    --panel: rgba(5, 11, 22, 0.82);
    --panel-border: rgba(96, 173, 232, 0.52);
    --accent: rgb(80, 211, 255);
    --accent-secondary: rgb(185, 101, 255);
    --warning: rgb(255, 183, 67);
    --danger: rgb(255, 92, 91);
    --success: rgb(87, 236, 139);
}

.gameplay-shell {
    flex-grow: 1;
    min-width: 920px;
    min-height: 600px;
    color: var(--text);
    background-color: rgb(2, 5, 12);
    overflow: hidden;
    padding: 20px 24px 14px 24px;
}

.gameplay-background,
.gameplay-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.gameplay-background { opacity: 0.88; }
.gameplay-vignette { background-color: rgba(0, 4, 12, 0.24); }

.session-kicker {
    position: absolute;
    top: 119px;
    left: 28%;
    right: 28%;
    -unity-text-align: middle-center;
    color: rgba(202, 230, 250, 0.82);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.hud-top {
    height: 96px;
    min-height: 96px;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
}

.hud-panel {
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 10px;
}

.track-panel {
    width: 250px;
    padding: 10px 16px;
    justify-content: center;
}

.brand { color: var(--accent); font-size: 13px; -unity-font-style: bold; letter-spacing: 2px; }
.track-name { font-size: 24px; -unity-font-style: bold; margin-top: 1px; }
.eyebrow, .metric-label, .rail-title {
    color: var(--muted);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.progress-panel {
    width: 39%;
    justify-content: center;
    align-items: stretch;
    padding-left: 22px;
    padding-right: 22px;
}

.song-progress-track {
    height: 8px;
    background-color: rgba(125, 164, 204, 0.25);
    border-radius: 4px;
    overflow: hidden;
}

.song-progress-fill { height: 8px; width: 0%; background-color: var(--accent); border-radius: 4px; }
.song-position { align-self: center; margin-top: 9px; font-size: 13px; color: rgb(211, 228, 243); }

.score-panel {
    width: 420px;
    flex-direction: row;
    justify-content: flex-end;
}

.metric { min-width: 150px; padding: 10px 14px; justify-content: center; align-items: flex-end; }
.metric--compact { min-width: 110px; }
.metric-value { font-size: 30px; -unity-font-style: bold; }
.metric-value--small { font-size: 22px; }
.metric-value--accent { color: var(--warning); }

.gameplay-content {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    margin-top: 2px;
}

.side-rail {
    width: 210px;
    min-width: 175px;
    justify-content: flex-end;
    padding-bottom: 72px;
}

.side-rail--left { margin-right: 16px; }
.side-rail--right { margin-left: 16px; }
.rail-card { padding: 13px; margin-top: 10px; }
.rail-value { color: var(--accent); font-size: 14px; -unity-font-style: bold; margin-top: 7px; white-space: normal; }
.rail-copy { color: var(--muted); font-size: 11px; margin-top: 5px; white-space: normal; }
.timing-row { font-size: 12px; margin-top: 7px; -unity-font-style: bold; }
.timing-row--perfect { color: var(--success); }
.timing-row--good { color: var(--accent); }
.timing-row--warning { color: var(--warning); }
.timing-row--miss { color: var(--danger); }
.current-input { margin-top: 9px; font-size: 13px; -unity-font-style: bold; white-space: normal; }

.highway-column {
    flex-grow: 1;
    min-width: 560px;
    align-items: stretch;
    justify-content: flex-end;
}

.highway-host {
    flex-grow: 1;
    min-height: 320px;
    position: relative;
}

.environment-identity {
    position: absolute;
    left: 28%;
    right: 28%;
    top: 13px;
    min-height: 45px;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 7, 17, 0.68);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--panel-border);
}

.environment-title {
    color: var(--text);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.environment-subtitle {
    color: var(--accent);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 2px;
}

.highway-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.impact-cue {
    position: absolute;
    left: 41%;
    right: 41%;
    height: 24px;
    margin-top: -12px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    color: rgb(239, 253, 255);
    background-color: rgba(2, 10, 19, 0.90);
    border-width: 1px;
    border-color: rgba(123, 229, 255, 0.88);
    border-radius: 12px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.kit-guidance-label {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 358px;
    height: 27px;
    -unity-text-align: middle-center;
    color: rgb(226, 243, 255);
    background-color: rgba(3, 9, 19, 0.86);
    border-width: 1px;
    border-color: rgba(91, 208, 255, 0.48);
    border-radius: 13px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.kit-visual-host {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 154px;
    height: 204px;
    min-height: 204px;
}

.gameplay-kit-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(1, 7, 15, 0.48);
    border-top-width: 1px;
    border-color: rgba(108, 190, 235, 0.24);
    border-top-left-radius: 46px;
    border-top-right-radius: 46px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.kit-piece {
    position: absolute;
    overflow: visible;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    background-color: rgba(3, 9, 17, 0.78);
    transition-property: scale, opacity, background-color, border-color;
    transition-duration: 0.08s;
}

.kit-piece--cymbal {
    border-radius: 999px;
    border-top-width: 3px;
    border-bottom-width: 1px;
}

.kit-piece--drum {
    border-radius: 999px;
    border-width: 3px;
}

.kit-piece--kick {
    border-radius: 999px;
    border-width: 4px;
}

.kit-piece--active { scale: 1.045; }
.kit-piece--hit { scale: 1.09; }

.kit-zone {
    position: absolute;
    border-radius: 999px;
    border-width: 1px;
    transition-property: background-color, border-color;
    transition-duration: 0.06s;
}

.kit-zone--edge {
    left: 4%;
    top: 5%;
    right: 4%;
    bottom: 5%;
    border-width: 4px;
}

.kit-zone--body {
    left: 18%;
    top: 18%;
    right: 18%;
    bottom: 18%;
}

.kit-zone--center {
    left: 39%;
    top: 30%;
    right: 39%;
    bottom: 30%;
    border-width: 2px;
}

.kit-zone--pedal {
    left: 38%;
    right: 38%;
    top: 58%;
    bottom: 5%;
    border-radius: 7px;
}

.kit-piece-label {
    position: absolute;
    left: -8%;
    right: -8%;
    bottom: 36%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.92);
    letter-spacing: 1px;
}

.kit-zone-label {
    position: absolute;
    left: -12%;
    right: -12%;
    bottom: 17%;
    -unity-text-align: middle-center;
    font-size: 7px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.kit-piece--kick .kit-piece-label { bottom: 43%; font-size: 12px; }
.kit-piece--kick .kit-zone-label { bottom: 29%; }
.kit-piece--cymbal .kit-piece-label { bottom: 32%; }
.kit-piece--cymbal .kit-zone-label { bottom: 13%; }

.kit-theme--concert-stage { background-color: rgba(15, 8, 3, 0.48); border-color: rgba(255, 176, 73, 0.28); }
.kit-theme--precision-grid { background-color: rgba(1, 9, 17, 0.70); border-radius: 3px; }

.judgment-label {
    position: absolute;
    left: 35%;
    right: 35%;
    bottom: 384px;
    height: 34px;
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--accent);
    letter-spacing: 2px;
}

.countdown-overlay {
    position: absolute;
    left: 28%;
    right: 28%;
    top: 25%;
    min-height: 220px;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 8, 18, 0.9);
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 18px;
}

.countdown-heading {
    color: var(--accent);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.countdown-label {
    margin-top: -6px;
    height: 118px;
    -unity-text-align: middle-center;
    font-size: 96px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--accent);
}

.countdown-copy {
    margin-top: -12px;
    color: var(--muted);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.judgment--perfect { color: var(--success); }
.judgment--good { color: var(--accent); }
.judgment--early, .judgment--late { color: var(--warning); }
.judgment--miss { color: var(--danger); }

.targets-host {
    height: 96px;
    min-height: 96px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    margin-left: 2%;
    margin-right: 2%;
}

.lane-target {
    flex-grow: 1;
    min-width: 66px;
    margin-left: 3px;
    margin-right: 3px;
    padding: 8px 7px;
    background-color: rgba(5, 10, 20, 0.90);
    border-width: 2px;
    border-radius: 9px;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.target-header { flex-direction: row; align-items: center; justify-content: center; }
.target-key {
    min-width: 23px;
    height: 23px;
    margin-right: 6px;
    border-width: 1px;
    border-color: rgba(230, 242, 255, 0.55);
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.35);
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
}
.target-name { font-size: 12px; -unity-font-style: bold; white-space: normal; }
.target-subtitle { color: var(--muted); font-size: 9px; -unity-text-align: middle-center; margin-top: 5px; }
.target--active { scale: 1.06; background-color: rgba(255, 255, 255, 0.30); }

.kick-target-host { height: 74px; min-height: 74px; align-items: center; justify-content: center; }
.kick-target {
    width: 62%;
    height: 61px;
    padding: 7px 20px;
    border-width: 2px;
    border-radius: 26px;
    background-color: rgba(21, 8, 30, 0.92);
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}
.kick-target .target-name { font-size: 17px; }
.kick-target .target-subtitle { font-size: 11px; }

.footer-strip {
    height: 31px;
    min-height: 31px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: rgb(149, 174, 201);
    font-size: 10px;
    letter-spacing: 1px;
}

.footer-actions { flex-direction: row; align-items: center; }
.gameplay-menu-button {
    height: 26px;
    min-width: 80px;
    margin-left: 14px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: rgba(111, 176, 222, 0.48);
    border-radius: 5px;
    background-color: rgba(4, 12, 24, 0.88);
    color: rgb(184, 207, 228);
    font-size: 9px;
    -unity-font-style: bold;
}
.gameplay-menu-button:hover, .gameplay-menu-button:focus { border-color: var(--accent); color: white; }

.run-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 3, 10, 0.84);
}

.run-dialog,
.results-dialog {
    width: 520px;
    max-width: 82%;
    padding: 30px;
    align-items: center;
    background-color: rgba(5, 12, 25, 0.98);
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 14px;
}

.results-dialog { width: 720px; }
.run-dialog-title { font-size: 34px; -unity-font-style: bold; letter-spacing: 3px; }
.run-dialog-copy { color: var(--muted); margin-top: 9px; margin-bottom: 20px; }
.run-primary-button,
.run-secondary-button {
    min-width: 210px;
    height: 44px;
    margin: 6px;
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 7px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.run-primary-button { color: rgb(0, 8, 18); background-color: var(--accent); }
.run-secondary-button { color: var(--text); background-color: rgba(10, 24, 42, 0.92); }
.run-primary-button:focus, .run-secondary-button:focus { border-width: 3px; }
.results-eyebrow { color: var(--accent); }
.result-rank { font-size: 98px; -unity-font-style: bold; color: var(--warning); margin-top: -6px; }
.results-metrics { width: 100%; flex-direction: row; justify-content: center; }
.result-metric { min-width: 180px; align-items: center; margin: 7px; }
.result-value { font-size: 25px; -unity-font-style: bold; margin-top: 4px; }
.result-breakdown { color: var(--muted); margin-top: 20px; margin-bottom: 10px; }
.result-practice { margin-top: 2px; margin-bottom: 8px; color: rgb(255, 202, 103); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.result-calibration { min-height: 32px; color: rgb(91, 224, 255); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.result-calibration-button { align-self: center; width: 300px; min-height: 38px; margin-top: 8px; margin-bottom: 10px; }
.gameplay--high-contrast .highway-shell,
.gameplay--high-contrast .results-dialog,
.gameplay--high-contrast .run-dialog { border-color: white; background-color: rgba(0, 0, 0, 0.97); }
.gameplay--high-contrast Label { color: white; }
.gameplay--reduced-motion .judgment { transition-duration: 0s; }
.result-actions { flex-direction: row; }

.theme--concert-stage { --accent: rgb(255, 176, 73); --accent-secondary: rgb(75, 165, 255); --panel-border: rgba(255, 175, 72, 0.45); }
.theme--concert-stage .gameplay-background { opacity: 1; }
.theme--concert-stage .gameplay-vignette { background-color: rgba(14, 5, 2, 0.10); }
.theme--concert-stage .hud-top { height: 86px; min-height: 86px; }
.theme--concert-stage .gameplay-content { margin-left: 3%; margin-right: 3%; }
.theme--concert-stage .side-rail { width: 168px; min-width: 150px; padding-bottom: 118px; }
.theme--concert-stage .hud-panel { background-color: rgba(12, 8, 6, 0.76); }
.theme--concert-stage .highway-host { margin-left: 7%; margin-right: 7%; min-height: 285px; }
.theme--concert-stage .environment-identity { left: 31%; right: 31%; top: 5px; background-color: rgba(17, 8, 3, 0.72); }
.theme--concert-stage .targets-host { height: 84px; min-height: 84px; margin-left: 4%; margin-right: 4%; }
.theme--concert-stage .lane-target {
    min-width: 58px;
    min-height: 76px;
    margin-left: 5px;
    margin-right: 5px;
    border-radius: 42px;
    border-width: 3px;
    background-color: rgba(18, 12, 9, 0.58);
}
.theme--concert-stage .target-key { border-radius: 12px; background-color: rgba(0, 0, 0, 0.58); }
.theme--concert-stage .target-subtitle { display: none; }
.theme--concert-stage .kick-target-host { height: 94px; min-height: 94px; }
.theme--concert-stage .kick-target { width: 38%; height: 82px; border-radius: 41px; border-width: 3px; background-color: rgba(15, 9, 7, 0.62); }
.theme--concert-stage .judgment-label { bottom: 384px; }

.theme--precision-grid { --accent: rgb(91, 220, 255); --accent-secondary: rgb(87, 135, 255); --panel-border: rgba(92, 198, 239, 0.36); }
.theme--precision-grid .gameplay-background { opacity: 1; }
.theme--precision-grid .gameplay-vignette { background-color: rgba(0, 7, 16, 0.08); }
.theme--precision-grid .gameplay-content { margin-left: 1%; margin-right: 1%; }
.theme--precision-grid .hud-panel { background-color: rgba(3, 10, 18, 0.91); border-radius: 3px; }
.theme--precision-grid .environment-identity { left: 34%; right: 34%; border-radius: 0; background-color: rgba(2, 10, 18, 0.82); }
.theme--precision-grid .side-rail { padding-bottom: 66px; }
.theme--precision-grid .lane-target { border-radius: 2px; border-width: 1px; background-color: rgba(3, 12, 21, 0.62); }
.theme--precision-grid .target-key { border-radius: 1px; }
.theme--precision-grid .kick-target { border-radius: 3px; width: 78%; border-width: 1px; background-color: rgba(24, 7, 8, 0.58); }

.theme--arcade-neon .environment-identity { background-color: rgba(2, 7, 17, 0.74); }
.theme--arcade-neon .lane-target { border-width: 2px; background-color: rgba(4, 9, 24, 0.82); }

@media (max-width: 1250px) {
    .gameplay-shell { padding-left: 12px; padding-right: 12px; }
    .side-rail { width: 160px; min-width: 145px; }
    .track-panel { width: 205px; }
    .score-panel { width: 360px; }
    .metric { min-width: 125px; }
    .metric--compact { min-width: 100px; }
    .metric-value { font-size: 25px; }
    .target-name { font-size: 10px; }
    .target-subtitle { display: none; }
}

@media (max-width: 1040px) {
    .side-rail { display: none; }
    .highway-column { min-width: 0; }
    .progress-panel { width: 30%; }
}
